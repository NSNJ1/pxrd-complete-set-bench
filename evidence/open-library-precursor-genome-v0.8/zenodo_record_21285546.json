{"created": "2026-07-10T16:50:23.987196+00:00", "modified": "2026-07-23T15:20:40.380738+00:00", "id": 21285546, "conceptrecid": "21285545", "doi": "10.5281/zenodo.21285546", "conceptdoi": "10.5281/zenodo.21285545", "doi_url": "https://doi.org/10.5281/zenodo.21285546", "metadata": {"title": "Precursor Genome", "doi": "10.5281/zenodo.21285546", "publication_date": "2026-07-09", "description": "<p class=\"font-claude-response-body break-words whitespace-normal\"><strong>The Precursor Genome</strong> is a dataset of 1,035 pairwise solid-state (ceramic) synthesis reactions generated autonomously by the A-Lab self-driving laboratory, spanning 46 distinct precursor materials. Each reaction is reported with full experimental metadata &mdash; measured thermal profiles, precursor and recovered masses, and instrument configuration &mdash; alongside the X-ray diffraction data used to identify its product phases.</p>\n<p class=\"font-claude-response-body break-words whitespace-normal\">Product mixtures were identified from 1,351 raw XRD scans through automated Rietveld refinement, yielding 1,950 refinement cases independently validated by human experts on a three-tier quality scale. Raw pattern files, serialized refinement objects, and reviewer annotations are included, preserving full traceability from each precursor pair to its final phase assignment.</p>\n<p class=\"font-claude-response-body break-words whitespace-normal\">This record contains the dataset's raw XRD scans, refinement objects (.pkl), and refinement plots. The Pydantic-validated JSON ledger, schema, and access-code notebooks are distributed separately via GitHub: <a href=\"https://github.com/lauren-walters/precursor-genome.git\">https://github.com/lauren-walters/precursor-genome.git</a>.</p>\n<p class=\"font-claude-response-body break-words whitespace-normal\">Released under CC BY 4.0.</p>", "access_right": "open", "creators": [{"name": "Walters, Lauren", "affiliation": "University of California, Berkeley", "orcid": "0000-0002-9710-9146"}, {"name": "Matthew, McDermott", "affiliation": "Lawrence Berkeley National Laboratory", "orcid": "0000-0002-4071-3000"}, {"name": "Bernardus, Rendy", "affiliation": "University of California, Berkeley", "orcid": "0000-0001-8309-6279"}, {"name": "Yuxing, Fei", "affiliation": "University of California, Berkeley", "orcid": "0000-0002-1225-2083"}, {"name": "Gerbrand, Ceder", "affiliation": "University of California, Berkeley", "orcid": "0000-0002-9021-279X"}], "dates": [{"type": "available"}], "version": "1.0", "language": "eng", "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "grants": [{"code": "DE-AC02-05-CH11231", "internal_id": "01bj3aw27::DE-AC02-05-CH11231", "funder": {"name": "United States Department of Energy"}}], "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "21285545"}}]}}, "title": "Precursor Genome", "links": {"self": "https://zenodo.org/api/records/21285546", "self_html": "https://zenodo.org/records/21285546", "preview_html": "https://zenodo.org/records/21285546?preview=1", "doi": "https://doi.org/10.5281/zenodo.21285546", "self_doi": "https://doi.org/10.5281/zenodo.21285546", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21285546", "reserve_doi": "https://zenodo.org/api/records/21285546/draft/pids/doi", "parent": "https://zenodo.org/api/records/21285545", "parent_html": "https://zenodo.org/records/21285545", "parent_doi": "https://doi.org/10.5281/zenodo.21285545", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.21285545", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:21285546/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:21285546/sequence/default", "files": "https://zenodo.org/api/records/21285546/files", "media_files": "https://zenodo.org/api/records/21285546/media-files", "latest": "https://zenodo.org/api/records/21285546/versions/latest", "latest_html": "https://zenodo.org/r